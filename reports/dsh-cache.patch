+        self.assertFalse(any(e['type'] == 'cache_prefix_reused' for e in report.events))
+        self.assertNotIn('old nested guidance', str(self.router.calls[-1]))
+
+    def test_new_guidance_appends_without_rewriting_previous_prefix(self):
