[
  {
    "id": "policy",
    "name": "policy:core",
    "config": {
      "mode": "default",
      "sandbox": "workspace-write",
      "allow": [
        "read_file",
        "list_dir",
        "grep",
        "tool_search",
        "skill_list",
        "memory_recall",
        "spawn_subagent"
      ],
      "ask": [
        "shell_exec"
      ],
      "deny": []
    }
  },
  {
    "id": "loop",
    "name": "loop:core",
    "config": {
      "maxSteps": 12,
      "maxDepth": 2,
      "spawnBudget": 8
    }
  },
  {
    "id": "model",
    "name": "model:router",
    "config": {
      "primary": [
        "lite",
        ""
      ],
      "fallback": [
        [
          "medium",
          ""
        ],
        [
          "premium",
          ""
        ]
      ],
      "moa": true,
      "moaModels": [
        [
          "lite",
          ""
        ],
        [
          "medium",
          ""
        ]
      ],
      "routing": {
        "strategy": "balanced",
        "tiers": [
          [
            "lite",
            ""
          ],
          [
            "medium",
            ""
          ]
        ],
        "premium": [
          [
            "premium",
            ""
          ]
        ],
        "small": [
          "lite",
          ""
        ],
        "notes": "三档智能路由（0.7.0）：tiers 按档位排序（lite=经济档，medium=均衡档），premium = 高端集成裁决档。strategy 可被 CLI --strategy 覆盖。用户通过 setup 命令配置实际 provider 后，档位名自动绑定到对应的 provider/model。"
      },
      "notes": "默认档位命名：lite（经济）/ medium（均衡）/ premium（高端）。用户通过 setup 命令或 forge.patch.json 绑定实际 provider。"
    }
  },
  {
    "id": "thinking",
    "name": "thinking:mode",
    "config": {
      "mode": "off",
      "notes": "三档沉思模式（capability thinking.mode）：off=默认不开启 / smart=按任务复杂度智能选择（触发词或长文本，消费库函数 looks_complex）/ on=默认开启。启用后运行首尾消费 should_think/estimate_budget/build_thinking_task/split_thinking/converged。"
    }
  },
  {
    "id": "lite",
    "name": "provider:lite",
    "config": {
      "wire": "openai",
      "baseURL": "https://api.deepseek.com",
      "apiKey": {
        "$expr": "get('env.FORGE_DEEPSEEK_KEY', '')"
      },
      "model": "deepseek-flash",
      "smallModel": "deepseek-flash",
      "notes": "经济档 provider：按成本升序路由时首选。用户通过 setup 命令配置实际 API。"
    }
  },
  {
    "id": "medium",
    "name": "provider:medium",
    "config": {
      "wire": "anthropic",
      "baseURL": "http://127.0.0.1:8810",
      "apiKey": {
        "$expr": "get('env.FORGE_MIMO_KEY', 'local')"
      },
      "model": "claude-sonnet-5",
      "notes": "均衡档 provider：中端主力，balanced 策略默认首选。"
    }
  },
  {
    "id": "premium",
    "name": "provider:premium",
    "config": {
      "wire": "anthropic",
      "baseURL": "http://127.0.0.1:8811",
      "apiKey": {
        "$expr": "get('env.FORGE_REVIEW_KEY', 'local')"
      },
      "model": "claude-opus-5",
      "notes": "高端档 provider：premium 策略的集成裁决档。"
    }
  }
]