[
  {
    "id": "policy",
    "name": "policy:core",
    "config": {
      "mode": "default",
      "sandbox": "workspace-write",
      "allow": [
        "read_file",
        "list_dir",
        "grep",
        "tool_search",
        "skill_list",
        "memory_recall",
        "spawn_subagent"
      ],
      "ask": [
        "shell_exec"
      ],
      "deny": []
    }
  },
  {
    "id": "loop",
    "name": "loop:core",
    "config": {
      "maxSteps": 12,
      "maxDepth": 2,
      "spawnBudget": 8
    }
  },
  {
    "id": "model",
    "name": "model:router",
    "config": {
      "primary": [
        "medium",
        "deepseek-flash"
      ],
      "fallback": [
        [
          "lite",
          "claude-sonnet-5"
        ],
        [
          "premium",
          "claude-opus-5"
        ]
      ],
      "moa": true,
      "moaModels": [
        [
          "medium",
          "deepseek-flash"
        ],
        [
          "lite",
          "claude-sonnet-5"
        ]
      ],
      "routing": {
        "strategy": "balanced",
        "tiers": [
          [
            "lite",
            "claude-sonnet-5"
          ],
          [
            "medium",
            "deepseek-flash"
          ]
        ],
        "premium": [
          [
            "premium",
            "claude-opus-5"
          ]
        ],
        "small": [
          "medium",
          "deepseek-flash"
        ],
        "notes": "三档智能路由（0.7.0）：tiers 按成本升序（lite=经济档，medium=均衡档），premium = 高端集成裁决档。档位 id 抽象、模型名具体；用户通过 forge setup 或 forge.patch.json 把档位绑到自己的 provider。strategy 可被 CLI --strategy 覆盖。"
      },
      "notes": "默认档位命名：lite（经济）/ medium（均衡）/ premium（高端）。model 行的 [provider_id, model] 对要求 model 非空——空串无法解析。用户通过 setup 命令或 forge.patch.json 覆盖为真实 provider。"
    }
  },
  {
    "id": "thinking",
    "name": "thinking:mode",
    "config": {
      "mode": "off",
      "notes": "三档沉思模式（capability thinking.mode）：off=默认不开启 / smart=按任务复杂度智能选择（触发词或长文本，消费库函数 looks_complex）/ on=默认开启。启用后运行首尾消费 should_think/estimate_budget/build_thinking_task/split_thinking/converged。"
    }
  },
  {
    "id": "lite",
    "name": "provider:lite",
    "config": {
      "wire": "anthropic",
      "baseURL": "http://127.0.0.1:8810",
      "apiKey": {
        "$expr": "get('env.FORGE_LITE_KEY', 'local')"
      },
      "model": "claude-sonnet-5",
      "notes": "经济档 provider（占位示例）：本地环回协议翻译网关。用户应通过 forge setup 或 forge.patch.json 覆盖为真实 provider。"
    }
  },
  {
    "id": "medium",
    "name": "provider:medium",
    "config": {
      "wire": "openai",
      "baseURL": "https://api.deepseek.com",
      "apiKey": {
        "$expr": "get('env.FORGE_MEDIUM_KEY', '')"
      },
      "model": "deepseek-flash",
      "smallModel": "deepseek-flash",
      "notes": "均衡档 provider（默认）：官方 OpenAI 兼容接口。凭据由环境变量注入（FORGE_MEDIUM_KEY），不落盘、不进日志。"
    }
  },
  {
    "id": "premium",
    "name": "provider:premium",
    "config": {
      "wire": "anthropic",
      "baseURL": "http://127.0.0.1:8811",
      "apiKey": {
        "$expr": "get('env.FORGE_PREMIUM_KEY', 'local')"
      },
      "model": "claude-opus-5",
      "notes": "高端档 provider（占位示例）：独立审查通道。示例指向本地网关，按需替换为你自己的高成本档。"
    }
  }
]
