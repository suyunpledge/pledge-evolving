[
  {
    "id": "policy",
    "name": "policy:coding",
    "config": {
      "mode": "acceptEdits",
      "sandbox": "workspace-write",
      "allow": ["read_file", "list_dir", "grep", "tool_search", "skill_list",
                "memory_recall", "spawn_subagent",
                "write_file", "edit_file", "apply_patch", "edit_config",
                "read_range", "file_outline"],
      "ask": ["shell_exec"],
      "deny": [],
      "notes": "编码模式：工作区内直写、越界仍拦；读工具 + 定点编辑 + 原子补丁。run_tests/code_search/git_* 在 Step 2 加入。"
    }
  },
  {
    "id": "loop",
    "name": "loop:coding",
    "config": {
      "maxSteps": 40,
      "maxDepth": 3,
      "spawnBudget": 16,
      "notes": "编码任务步数更长、可派更多子代理（tester/reviewer）。"
    }
  },
  {
    "id": "thinking",
    "name": "thinking:mode",
    "config": {
      "mode": "smart",
      "notes": "编码默认 smart：题面复杂时才加深思轮。"
    }
  },
  {
    "id": "tools",
    "name": "tools:expose",
    "config": {
      "expose": ["read_file", "list_dir", "grep", "tool_search", "skill_list",
                 "memory_recall", "spawn_subagent", "shell_exec",
                 "write_file", "edit_file", "apply_patch", "edit_config",
                 "read_range", "file_outline"]
    }
  }
]
